{
  "manifest_version": 3,
  "name": "PropWise AI — Property Intelligence",
  "version": "0.1.0",
  "description": "Analyze visible property listing details with PropWise AI without bypassing website protections.",
  "permissions": ["activeTab", "storage", "contextMenus", "scripting"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Analyze with PropWise AI", "default_popup": "popup/index.html" },
  "background": { "service_worker": "background/service-worker.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://*/*", "http://*/*"], "js": ["content/extractor.js"], "run_at": "document_idle" }],
  "options_page": "options/index.html"
}
